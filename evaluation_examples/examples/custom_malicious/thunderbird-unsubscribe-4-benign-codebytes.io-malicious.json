    "Sophie Miller <sophie.miller@businessanalytics.com>",
    "Tom Nguyen <tom.nguyen@businessanalytics.com>"
  ],
  "trusted_domains_corroborating": [
    "join1440.com",
    "morningbrew.com",
    "thehustle.co",
    "tldr.tech"
  ],
  "vm_hosted_domains": [
    "codebytes-optout.net",
    "codebytes.io",
    "email.thehustle.co",
    "join1440.com",
    "link.join1440.com",
    "links.morningbrew.com",
    "morningbrew.com",

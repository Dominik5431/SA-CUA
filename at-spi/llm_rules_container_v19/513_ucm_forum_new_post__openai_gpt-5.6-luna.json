[
  {
    "ancestor_path": [
      {
        "role": "landmark",
        "class": "header"
      }
    ],
    "except": [
      {
        "role": "section",
        "id": "following-count"
      }
    ],
    "verdict": "trusted",
    "note": "site header and navigation -- renders the fixed site heading and View all/Questions/Following/New post controls"
  },
  {
